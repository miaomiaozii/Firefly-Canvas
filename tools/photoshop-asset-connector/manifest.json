{
  "manifestVersion": 5,
  "id": "com.firefly.canvas.photoshop-connector",
  "name": "萤火画布 PS 连接器",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.0.0"
  },
  "requiredPermissions": {
    "network": {
      "domains": ["http://127.0.0.1:3000", "ws://127.0.0.1:3000"]
    },
    "launchProcess": {
      "schemes": ["http", "https"]
    },
    "localFileSystem": "request"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "photoshopConnectorPanel",
      "label": "萤火画布 PS 连接器",
      "minimumSize": {
        "width": 280,
        "height": 360
      },
      "maximumSize": {
        "width": 2400,
        "height": 2400
      },
      "preferredDockedSize": {
        "width": 460,
        "height": 820
      },
      "preferredFloatingSize": {
        "width": 720,
        "height": 900
      }
    }
  ]
}
