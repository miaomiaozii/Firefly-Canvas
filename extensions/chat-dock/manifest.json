{
  "manifest_version": 3,
  "name": "Firefly 对话采集",
  "version": "0.1.0",
  "description": "手动把选中的对话文字或悬停图片送到已打开的 Firefly 画布。",
  "key": "",
  "permissions": ["storage", "scripting", "declarativeNetRequest"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://chat.deepseek.com/*",
    "https://chat.qwen.ai/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js"},
  "options_ui": {"page": "options.html", "open_in_tab": true},
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://chat.deepseek.com/*",
        "https://chat.qwen.ai/*",
        "https://www.doubao.com/*",
        "https://www.kimi.com/*",
        "https://yuanbao.tencent.com/*"
      ],
      "js": ["protocol.js", "chat-content.js"],
      "all_frames": true
    },
    {
      "matches": ["http://127.0.0.1/static/smart-canvas.html*"],
      "js": ["protocol.js", "canvas-relay.js"],
      "all_frames": true
    }
  ]
}
